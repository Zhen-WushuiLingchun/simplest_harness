{
  "name": "tmsh",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "description": "The most simplest model-directed AI harness",
  "type": "module",
  "bin": {
    "tmsh": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js",
    "tui": "bun dist/cli.js tui",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.36",
    "@ai-sdk/openai": "^4.0.36",
    "@ai-sdk/openai-compatible": "^3.0.28",
    "@inquirer/prompts": "7.10.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentui/core": "^0.5.1",
    "ai": "^7.0.58",
    "zod": "^4.4.3"
  }
}
